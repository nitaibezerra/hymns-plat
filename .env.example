# =============================================================================
# Hinaria — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Local dev uses config.settings.local with sensible defaults — most vars below
# are only required in production (Railway).

# -----------------------------------------------------------------------------
# REQUIRED FOR PRODUCTION (Railway)
# -----------------------------------------------------------------------------

# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

DJANGO_DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings.production

# Hosts and CSRF — Railway URL + custom domain
DJANGO_ALLOWED_HOSTS=hinaria.com.br,www.hinaria.com.br,.up.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://beta.hinaria.com.br,https://hinaria.com.br,https://www.hinaria.com.br,https://*.up.railway.app

# -----------------------------------------------------------------------------
# SPA em beta (beta.hinaria.com.br → hinaria.com.br/graphql/)
# -----------------------------------------------------------------------------
# A SPA SvelteKit sobe primeiro em `beta.hinaria.com.br` e fala com este
# backend no apex. Isso é cross-origin, e são QUATRO variáveis, cada uma
# cobrindo uma coisa diferente. Faltando qualquer uma, o beta parece "quase
# funcionar" e o sintoma não aponta a causa:
#
#   DJANGO_CSRF_TRUSTED_ORIGINS  falta beta → mutation 403 "Origin checking failed"
#   CORS_ALLOWED_ORIGINS         falta beta → "blocked by CORS policy" no console
#   CSRF_COOKIE_DOMAIN           vazio      → mutation 403 (a página em beta. não
#                                             consegue ler `csrftoken` do
#                                             `document.cookie` do apex)
#   SESSION_COOKIE_DOMAIN        vazio      → SSR anônimo: header mostra "Entrar" e
#                                             /editor redireciona pra /login com
#                                             editor logado
#
# Origens que podem falar com este backend por CORS. Nunca use
# `CORS_ALLOW_ALL_ORIGINS` em produção — `CORS_ALLOW_CREDENTIALS` é `True`.
CORS_ALLOWED_ORIGINS=https://beta.hinaria.com.br,https://hinaria.com.br,https://www.hinaria.com.br

# Escopo dos cookies. Vazio (o default) = host-only, que é o certo enquanto a
# UI e o backend estiverem no MESMO host. Enquanto a SPA viver em `beta.`,
# ambos precisam do ponto na frente para atravessar o subdomínio. No cutover,
# quando a SPA assumir o apex, esvazie os dois de novo.
SESSION_COOKIE_DOMAIN=.hinaria.com.br
CSRF_COOKIE_DOMAIN=.hinaria.com.br

# Wagtail admin — absolute URL (used for emails/previews)
WAGTAILADMIN_BASE_URL=https://hinaria.com.br

# SEO — tokens de verificação de propriedade (Search Console / Bing Webmaster).
# Deixe vazio em dev; preencha em produção com o token "HTML tag" de cada painel.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Railway injects this automatically once the Postgres service is added
DATABASE_URL=

# Redis is optional — Celery is dormant in v1, so this can stay empty
REDIS_URL=

# Force HTTPS redirect in prod
SECURE_SSL_REDIRECT=True

# -----------------------------------------------------------------------------
# OPTIONAL — Email via Resend (falls back to console backend if empty)
# -----------------------------------------------------------------------------
EMAIL_HOST=smtp.resend.com
EMAIL_PORT=587
EMAIL_HOST_USER=resend
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Hinaria <noreply@hinaria.com.br>

# -----------------------------------------------------------------------------
# OPTIONAL — Cloudflare R2 storage for media
# (falls back to local /media if AWS_ACCESS_KEY_ID is empty)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=hinaria-media
AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
AWS_S3_CUSTOM_DOMAIN=media.hinaria.com.br

# -----------------------------------------------------------------------------
# OPTIONAL — Google OAuth (enables "Continuar com Google" button)
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs (must match exactly):
#   http://localhost:8000/accounts/google/login/callback/
#   https://hinaria.com.br/accounts/google/login/callback/
#   https://www.hinaria.com.br/accounts/google/login/callback/
#   https://hinaria-production.up.railway.app/accounts/google/login/callback/
# -----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# LOCAL DEVELOPMENT (config.settings.local — overrides above)
# -----------------------------------------------------------------------------
# DJANGO_SECRET_KEY=django-insecure-dev-key
# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DJANGO_SETTINGS_MODULE=config.settings.local
# DATABASE_URL=postgresql://hymnplat:hymnplat@localhost:5432/hymnplat
# REDIS_URL=redis://localhost:6379/0
