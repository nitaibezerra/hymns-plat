{
  "name": "hinaria-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy:beta": "wrangler deploy",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --project=chromium --reporter=list,html,json tests/e2e/_helpers tests/e2e/editor-dashboard.spec.ts tests/e2e/editor-crud.spec.ts tests/e2e/revise-hymn.spec.ts tests/e2e/player-persists.spec.ts",
    "test:e2e:parity": "HINARIA_E2E_PLAYWRIGHT_READY=1 playwright test --project=chromium tests/e2e/visual-parity.spec.ts",
    "test:e2e:helpers": "playwright test --project=chromium tests/e2e/_helpers",
    "codegen": "graphql-codegen --config codegen.config.ts",
    "gerar-icones": "node scripts/gerar-icones.mjs"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.0",
    "@graphql-codegen/typescript": "^4.0.0",
    "@graphql-codegen/typescript-operations": "^4.0.0",
    "@playwright/test": "^1.49.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.10.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/svelte": "^5.2.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "graphql": "^16.10.0",
    "jsdom": "^25.0.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.1.0",
    "svelte2tsx": "^0.7.55",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.0",
    "wrangler": "^4.127.0"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/inter-tight": "^5.2.7",
    "@fontsource/source-serif-4": "^5.2.9",
    "@urql/svelte": "^4.2.0"
  }
}
